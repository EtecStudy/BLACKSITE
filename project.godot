; BLACKSITE 0.1 - cooperative horror technical prototype
config_version=5

[application]
config/name="BLACKSITE"
run/main_scene="res://scenes/menu/main_menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]
Net="*res://scripts/networking/net.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.012, 0.02, 0.027, 1)

[input]
move_forward={"deadzone":0.2,"events":[{"physical_keycode":87,"type":"InputEventKey"}]}
move_back={"deadzone":0.2,"events":[{"physical_keycode":83,"type":"InputEventKey"}]}
move_left={"deadzone":0.2,"events":[{"physical_keycode":65,"type":"InputEventKey"}]}
move_right={"deadzone":0.2,"events":[{"physical_keycode":68,"type":"InputEventKey"}]}
sprint={"deadzone":0.2,"events":[{"physical_keycode":4194325,"type":"InputEventKey"}]}
